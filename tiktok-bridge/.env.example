# ĐÂY LÀ FILE MẪU — KHÔNG điền key/thông tin thật vào đây (file này được đưa lên GitHub).
# Bridge chỉ đọc file .env (tự tạo từ file này ở lần chạy đầu). Hãy sửa file .env.

# Tên TikTok đang phát live (không cần @).
# Để nguyên "ten_tiktok_cua_ban" (hoặc để trống) => chạy CHẾ ĐỘ DEMO: tự tạo quà/bình luận giả để test.
TIKTOK_USERNAME=ten_tiktok_cua_ban

# true = luôn chạy DEMO kể cả khi đã điền tên. DEMO_INTERVAL_MS = khoảng cách trung bình giữa 2 sự kiện giả.
DEMO=false
DEMO_INTERVAL_MS=20000

# Địa chỉ server .NET WeddingLive
SERVER_URL=http://localhost:5000

# Phải trùng với Wedding:ApiKey trong appsettings.json (để trống nếu không dùng)
API_KEY=

# (Khuyến nghị) API key Euler Stream - dịch vụ ký request mà thư viện dùng.
# Đăng ký miễn phí tại https://www.eulerstream.com
EULER_API_KEY=

# MC chào người mới vào phòng ("Hello Thảo Vy!"). false = tắt
GREET_JOIN=true
