{
  "name": "wedding-live-tiktok",
  "private": true,
  "description": "Lệnh tắt chạy từ thư mục gốc: npm start (bridge), npm run server (.NET), npm run setup (cài bridge)",
  "scripts": {
    "start": "npm --prefix tiktok-bridge start",
    "bridge": "npm --prefix tiktok-bridge start",
    "setup": "npm --prefix tiktok-bridge install",
    "preserver": "node -e \"try{require('child_process').execSync(process.platform==='win32'?'taskkill /IM WeddingLive.exe /F':'pkill -x WeddingLive',{stdio:'ignore'})}catch(e){}\"",
    "server": "dotnet run --project WeddingLive"
  }
}
